# Crie a chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo estável com saída estruturada. Pode ser alterado sem recompilar.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Contingência opcional pelo Vercel AI Gateway. Em deploys da Vercel, a
# autenticação OIDC é automática. Fora da Vercel, informe uma chave do Gateway.
AI_GATEWAY_API_KEY=
AI_GATEWAY_INTERVIEW_MODEL=reflection/beam
AI_GATEWAY_PLAN_MODEL=reflection/beam
# Supabase Auth (chave publicável/anon; nunca use a service_role no navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
